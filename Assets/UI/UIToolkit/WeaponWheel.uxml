<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
>
    <ui:Style src="WeaponWheel.uss" />
    <ui:VisualElement name="wheel-container" class="wheel-container">
        <!-- Backdrop dim overlay -->
        <ui:VisualElement name="wheel-backdrop" class="wheel-backdrop" picking-mode="Ignore" />

        <!-- Wheel Root Panel (680x680px) -->
        <ui:VisualElement name="wheel-root" class="wheel-root">
            <!-- Modular Slice Layers from User's Sprite Sheet -->
            <ui:VisualElement name="slice-slot-1" class="wheel-slice" picking-mode="Ignore" />
            <ui:VisualElement name="slice-slot-2" class="wheel-slice" picking-mode="Ignore" />
            <ui:VisualElement name="slice-slot-3" class="wheel-slice" picking-mode="Ignore" />
            <ui:VisualElement name="slice-slot-4" class="wheel-slice" picking-mode="Ignore" />
            <ui:VisualElement name="slice-skill" class="wheel-slice" picking-mode="Ignore" />
            <ui:VisualElement name="slice-ultimate" class="wheel-slice" picking-mode="Ignore" />

            <!-- Center Plate -->
            <ui:VisualElement name="slice-center" class="wheel-slice" picking-mode="Ignore" />

            <!-- Cooldown Vector Layer -->
            <ui:VisualElement name="cooldown-layer" class="wheel-slice" picking-mode="Ignore" />

            <!-- Weapon Slot Icons (anchored at exact centroids) -->
            <ui:VisualElement name="slot-1" class="slot-container slot-1-pos">
                <ui:VisualElement name="icon-1" class="slot-weapon-icon" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-2" class="slot-container slot-2-pos">
                <ui:VisualElement name="icon-2" class="slot-weapon-icon" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-3" class="slot-container slot-3-pos">
                <ui:VisualElement name="icon-3" class="slot-weapon-icon" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-4" class="slot-container slot-4-pos">
                <ui:VisualElement name="icon-4" class="slot-weapon-icon" />
            </ui:VisualElement>

            <!-- Ability Labels (anchored at exact centroids) -->
            <ui:VisualElement name="slot-skill" class="slot-container slot-skill-pos">
                <ui:Label text="SKILL" class="ability-title skill-title-color" />
                <ui:Label name="skill-subtext" text="Dash Forward" class="ability-subtext skill-subtext-color" />
            </ui:VisualElement>

            <ui:VisualElement name="slot-ultimate" class="slot-container slot-ultimate-pos">
                <ui:Label text="ULTIMATE" class="ability-title ult-title-color" />
                <ui:Label name="ultimate-subtext" text="Meteor Strike" class="ability-subtext ult-subtext-color" />
            </ui:VisualElement>

            <!-- Center Info Hub -->
            <ui:VisualElement name="center-hub" class="center-hub" picking-mode="Ignore">
                <ui:VisualElement name="center-hero-icon" class="center-hero-icon" />
                <ui:Label name="center-title" text="Pistol" class="center-title" />
                <ui:Label name="center-desc" text="Rapid fire handgun good for close range." class="center-desc" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
