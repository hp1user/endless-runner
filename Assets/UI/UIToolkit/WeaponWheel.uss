/* Weapon Wheel Sci-Fi HUD Styling with User Modular Sprite Sheet */

.wheel-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 0;
    top: 0;
}

.wheel-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 12, 0.65);
}

.wheel-root {
    position: relative;
    width: 680px;
    height: 680px;
    align-items: center;
    justify-content: center;
}

/* Slices & Layers (each is 680x680 mapped from 1024x1024 sprite sheet) */
.wheel-slice {
    position: absolute;
    left: 0;
    top: 0;
    width: 680px;
    height: 680px;
    -unity-background-scale-mode: scale-to-fit;
}

#slice-slot-1 {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/weapon_01_normal.png");
}

#slice-slot-2 {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/weapon_02_normal.png");
}

#slice-slot-3 {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/weapon_03_normal.png");
}

#slice-slot-4 {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/weapon_04_normal.png");
}

#slice-skill {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/skill_normal.png");
}

#slice-ultimate {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/ultimate_normal.png");
}

#slice-center {
    background-image: url("project:/Assets/UI/Sprite/WeaponWheel/center_plate.png");
}

/* Slot Containers (anchored at exact sector centroids) */
.slot-container {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.slot-1-pos {
    width: 120px;
    height: 80px;
    translate: -215px -89px;
}

.slot-2-pos {
    width: 120px;
    height: 80px;
    translate: -89px -215px;
}

.slot-3-pos {
    width: 120px;
    height: 80px;
    translate: 89px -215px;
}

.slot-4-pos {
    width: 120px;
    height: 80px;
    translate: 215px -89px;
}

.slot-skill-pos {
    width: 160px;
    height: 60px;
    translate: -152px 151px;
}

.slot-ultimate-pos {
    width: 160px;
    height: 60px;
    translate: 151px 151px;
}

.slot-weapon-icon {
    width: 90%;
    height: 90%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Ability Subtext Labels inside bottom segments */
.ability-title {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.ability-subtext {
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.skill-title-color {
    color: #6CE8FF;
    text-shadow: 0px 0px 8px rgba(0, 200, 255, 0.7);
}

.skill-subtext-color {
    color: #D4F4FF;
}

.ult-title-color {
    color: #FF8855;
    text-shadow: 0px 0px 8px rgba(255, 80, 0, 0.7);
}

.ult-subtext-color {
    color: #FFE0D0;
}

/* Center Info Hub */
.center-hub {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 130px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    padding: 10px;
}

.center-hero-icon {
    width: 100px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: -4px;
}

.center-title {
    color: #FFFFFF;
    font-size: 24px;
    -unity-font-style: bold;
    text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.9);
    margin-top: 2px;
    margin-bottom: 2px;
}

.center-desc {
    color: #A0B0C0;
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    max-width: 200px;
    white-space: normal;
    margin-top: 0px;
    padding: 0;
}

/* Floating Sci-Fi Mini-Dock Pill Popup */
.mini-dock-container {
    position: absolute;
    align-items: center;
    justify-content: center;
    display: none;
    z-index: 100;
}

.dock-pos-0 {
    translate: -250px -150px;
}

.dock-pos-1 {
    translate: -89px -290px;
}

.dock-pos-2 {
    translate: 89px -290px;
}

.dock-pos-3 {
    translate: 250px -150px;
}

.mini-dock-chassis {
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 24, 38, 0.94);
    border-color: #22D3EE;
    border-width: 1.5px;
    border-radius: 20px;
    padding: 4px 8px;
}

.mini-dock-chip {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    margin: 2px 4px;
    border-radius: 14px;
    background-color: rgba(30, 41, 59, 0.7);
    border-width: 1px;
    border-color: rgba(100, 116, 139, 0.4);
}

.mini-dock-chip-active {
    background-color: rgba(6, 182, 212, 0.4);
    border-color: #22D3EE;
}

.mini-dock-chip-icon {
    width: 24px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 6px;
}

.mini-dock-chip-label {
    color: #94A3B8;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mini-dock-chip-label-active {
    color: #FFFFFF;
    text-shadow: 0px 0px 6px rgba(34, 211, 238, 0.9);
}

.mini-dock-chip-ammo {
    color: #64748B;
    font-size: 10px;
    margin-left: 6px;
}

.mini-dock-chip-ammo-active {
    color: #67E8F9;
}

/* Multi-Weapon Slot Pips */
.slot-pips {
    position: absolute;
    bottom: -8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-pip-dot {
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
    background-color: #475569;
    margin-left: 2px;
    margin-right: 2px;
}

.slot-pip-dot-active {
    background-color: #22D3EE;
}
