.wheel-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.wheel-background {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background-color: rgba(30, 30, 35, 0.95);
    border-width: 4px;
    border-color: rgba(100, 100, 100, 0.8);
    -unity-background-scale-mode: scale-to-fit;
}

.highlight-layer {
    position: absolute;
    width: 600px;
    height: 600px;
}

.center-label {
    position: absolute;
    color: white;
    font-size: 40px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
}

.slot-container {
    position: absolute;
    width: 120px;
    height: 120px;
    align-items: center;
    justify-content: center;
}

/* Base positions relative to center, assuming radius of ~200px */
.top-mid-right { translate: 80px -180px; }
.top-right { translate: 180px -80px; }
.bottom-right { translate: 150px 150px; }
.bottom-left { translate: -150px 150px; }
.top-left { translate: -180px -80px; }
.top-mid-left { translate: -80px -180px; }

.slot-icon {
    width: 70%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}



.slot-name-label {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
    margin-top: -15px;
}

.large-slot-label {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
}

.skill-label {
    color: rgb(100, 255, 100); /* Neon Green */
}

.ultimate-label {
    color: rgb(100, 150, 255); /* Neon Blue */
}
