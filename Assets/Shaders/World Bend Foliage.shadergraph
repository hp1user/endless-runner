        {
            "m_Id": "8f2ed0e5b7c74b959c3632c9b332da54"
        },
        {
            "m_Id": "1c2aff130bcb4d8899b4a90c525bc3e1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BlendFoliage",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float zCoord = WorldPos.z + NoiseOffset;\nfloat xCoord = WorldPos.x;\n\nfloat2 uvMacro = float2(xCoord * 0.15, zCoord * 0.035);\nfloat2 iMac = floor(uvMacro); float2 fMac = frac(uvMacro); fMac = fMac * fMac * (3.0 - 2.0 * fMac);\nfloat4 hMac = frac(sin(float4(dot(iMac, float2(12.9898, 78.233)), dot(iMac + float2(1,0), float2(12.9898, 78.233)), dot(iMac + float2(0,1), float2(12.9898, 78.233)), dot(iMac + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nMacro = lerp(lerp(hMac.x, hMac.y, fMac.x), lerp(hMac.z, hMac.w, fMac.x), fMac.y);\n\nfloat2 uvMac2 = float2(xCoord * 0.12 + 4.7, zCoord * 0.042 + 9.1);\nfloat2 iMac2 = floor(uvMac2); float2 fMac2 = frac(uvMac2); fMac2 = fMac2 * fMac2 * (3.0 - 2.0 * fMac2);\nfloat4 hMac2 = frac(sin(float4(dot(iMac2, float2(12.9898, 78.233)), dot(iMac2 + float2(1,0), float2(12.9898, 78.233)), dot(iMac2 + float2(0,1), float2(12.9898, 78.233)), dot(iMac2 + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nMacro2 = lerp(lerp(hMac2.x, hMac2.y, fMac2.x), lerp(hMac2.z, hMac2.w, fMac2.x), fMac2.y);\n\nfloat2 uvMid = float2(xCoord * 0.35 + (nMacro - 0.5) * 1.5, zCoord * 0.18);\nfloat2 iMid = floor(uvMid); float2 fMid = frac(uvMid); fMid = fMid * fMid * (3.0 - 2.0 * fMid);\nfloat4 hMid = frac(sin(float4(dot(iMid, float2(12.9898, 78.233)), dot(iMid + float2(1,0), float2(12.9898, 78.233)), dot(iMid + float2(0,1), float2(12.9898, 78.233)), dot(iMid + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nMid = lerp(lerp(hMid.x, hMid.y, fMid.x), lerp(hMid.z, hMid.w, fMid.x), fMid.y);\n\nfloat2 uvTop = float2(xCoord * 0.8, zCoord * 0.75);\nfloat2 iTop = floor(uvTop); float2 fTop = frac(uvTop); fTop = fTop * fTop * (3.0 - 2.0 * fTop);\nfloat4 hTop = frac(sin(float4(dot(iTop, float2(12.9898, 78.233)), dot(iTop + float2(1,0), float2(12.9898, 78.233)), dot(iTop + float2(0,1), float2(12.9898, 78.233)), dot(iTop + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nTop = lerp(lerp(hTop.x, hTop.y, fTop.x), lerp(hTop.z, hTop.w, fTop.x), fTop.y);\n\nfloat centerTrackX = (nMacro - 0.5) * 4.5;\nfloat distFromTrack = abs(xCoord - centerTrackX);\nfloat centerWidth = lerp(0.8, 2.6, nMacro2);\nfloat centerFactor = exp(-distFromTrack * distFromTrack / (centerWidth * centerWidth));\nfloat centerIntensity = smoothstep(0.25, 0.65, nMacro2 * 1.25);\nfloat organicCenter = centerFactor * centerIntensity * (nMid * 0.65 + nTop * 0.35);\n\nfloat leftCurb = smoothstep(3.0, 5.0, -xCoord) * saturate(nMacro * 1.5 + 0.2);\nfloat rightCurb = smoothstep(3.0, 5.0, xCoord) * saturate((1.0 - nMacro) * 1.5 + 0.2);\nfloat organicCurb = (leftCurb + rightCurb) * (nMid * 0.6 + nTop * 0.4);\n\nfloat roadPatches = smoothstep(0.55, 0.85, nMid * nMacro) * 0.8;\n\nfloat totalRoadNoise = organicCurb + organicCenter + roadPatches;\nfloat overgrowth = smoothstep(0.20, 0.65, totalRoadNoise);\n\nfloat mossClump = smoothstep(0.35, 0.65, nTop * 0.55 + nMid * 0.45);\nfloat debrisClump = smoothstep(0.30, 0.70, (1.0 - nTop) * 0.55 + nMid * 0.45 + (1.0 - overgrowth) * 0.3);\n\nfloat slope = saturate(WorldNormal.y);\nfloat mossOnRoad = slope * overgrowth * mossClump * saturate(MossCoverage * 2.2);\nfloat debrisOnRoad = slope * overgrowth * debrisClump * saturate(DebrisCoverage * 2.2);\n\nfloat2 uvSideBase = float2(WorldPos.z + NoiseOffset, WorldPos.y * 2.2);\n\nfloat2 uvS1 = uvSideBase * 0.55;\nfloat2 iS1 = floor(uvS1); float2 fS1 = frac(uvS1); fS1 = fS1 * fS1 * (3.0 - 2.0 * fS1);\nfloat4 hS1 = frac(sin(float4(dot(iS1, float2(12.9898, 78.233)), dot(iS1 + float2(1,0), float2(12.9898, 78.233)), dot(iS1 + float2(0,1), float2(12.9898, 78.233)), dot(iS1 + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nS1 = lerp(lerp(hS1.x, hS1.y, fS1.x), lerp(hS1.z, hS1.w, fS1.x), fS1.y);\n\nfloat2 uvS2 = uvSideBase * 2.2 + float2(5.3, 1.7);\nfloat2 iS2 = floor(uvS2); float2 fS2 = frac(uvS2); fS2 = fS2 * fS2 * (3.0 - 2.0 * fS2);\nfloat4 hS2 = frac(sin(float4(dot(iS2, float2(12.9898, 78.233)), dot(iS2 + float2(1,0), float2(12.9898, 78.233)), dot(iS2 + float2(0,1), float2(12.9898, 78.233)), dot(iS2 + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nS2 = lerp(lerp(hS2.x, hS2.y, fS2.x), lerp(hS2.z, hS2.w, fS2.x), fS2.y);\n\nfloat2 uvS3 = uvSideBase * 5.4 + float2(2.1, 8.4);\nfloat2 iS3 = floor(uvS3); float2 fS3 = frac(uvS3); fS3 = fS3 * fS3 * (3.0 - 2.0 * fS3);\nfloat4 hS3 = frac(sin(float4(dot(iS3, float2(12.9898, 78.233)), dot(iS3 + float2(1,0), float2(12.9898, 78.233)), dot(iS3 + float2(0,1), float2(12.9898, 78.233)), dot(iS3 + float2(1,1), float2(12.9898, 78.233)))) * 43758.5453);\nfloat nS3 = lerp(lerp(hS3.x, hS3.y, fS3.x), lerp(hS3.z, hS3.w, fS3.x), fS3.y);\n\nfloat sideFBM = nS1 * 0.5 + nS2 * 0.35 + nS3 * 0.15;\n\nfloat verticalFace = 1.0 - slope;\nfloat baseClimb = saturate(1.15 - WorldPos.y * 1.6);\nfloat wallClimb = saturate(baseClimb + (nS2 - 0.4) * 0.55);\n\nfloat mossOnWall = verticalFace * smoothstep(0.40, 0.70, sideFBM * wallClimb * 1.25) * saturate(MossCoverage * 1.4);\n\nfloat baseDebris = saturate(1.0 - WorldPos.y * 3.5);\nfloat debrisOnWall = verticalFace * smoothstep(0.35, 0.75, (nS2 * 0.6 + nS3 * 0.4) * baseDebris) * saturate(DebrisCoverage * 1.4);\n\nfloat totalMoss = saturate(mossOnRoad + mossOnWall);\nfloat visDebris = saturate(debrisOnRoad + debrisOnWall);\n\nfloat3 safeBaseNormal = (BaseNormalTS.z > 0.05 && dot(BaseNormalTS, BaseNormalTS) > 0.2) ? normalize(BaseNormalTS) : float3(0.0, 0.0, 1.0);\nfloat3 debNorm = (dot(DebrisNormalTS, DebrisNormalTS) > 0.2) ? normalize(DebrisNormalTS) : float3(0.0, 0.0, 1.0);\nfloat3 mossNorm = (dot(MossNormalTS, MossNormalTS) > 0.2) ? normalize(MossNormalTS) : float3(0.0, 0.0, 1.0);\n\nfloat2 blendedXY = safeBaseNormal.xy * NormalStrength + debNorm.xy * visDebris * DebrisNormalStrength + mossNorm.xy * totalMoss * 1.2;\nfloat blendedZ = max(0.2, safeBaseNormal.z);\nOutNormalTS = normalize(float3(blendedXY, blendedZ));\n\nfloat3 col = lerp(BaseColor, DebrisAlbedo.rgb, visDebris);\ncol = lerp(col, MossAlbedo.rgb * MossColor.rgb, totalMoss);\n\nfloat totalOvergrowth = saturate(visDebris + totalMoss);\nOutColor = col;\nOutMetallic = lerp(BaseMetallic, 0.0, totalOvergrowth);\nOutSmoothness = lerp(BaseSmoothness, lerp(0.18, MossSmoothness, totalMoss / (totalOvergrowth + 1e-4)), totalOvergrowth);\nOutAO = lerp(BaseAO, 0.65, totalOvergrowth * 0.5);"
}

